{
  "cleanUrls": true,
  "trailingSlash": false,
  "rewrites": [
    {
      "source": "/p/:slug",
      "destination": "/product.html"
    },
    {
      "source": "/checkout",
      "destination": "/product.html"
    },
    {
      "source": "/admin",
      "destination": "/admin.html"
    },
    {
      "source": "/products",
      "destination": "/products.html"
    }
  ]
}